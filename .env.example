# Dominios / IPs autorizadas para CORS (separados por comas, o '*' para desarrollo local)
ALLOWED_ORIGINS=*

# Duración de validez de las sesiones de usuario en días (por defecto: 7 días)
SESSION_EXPIRE_DAYS=7

# Credenciales para la creación del usuario Administrador inicial (solo primer arranque)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Credenciales para acceder a la API de Google TTS (opcional, solo si se desea usar Google TTS)
GOOGLE_TTS_API_KEY=XXXXXXXXXXXXXXXXXXXX
